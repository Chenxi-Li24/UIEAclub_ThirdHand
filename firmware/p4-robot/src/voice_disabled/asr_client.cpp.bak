// asr_client.cpp - Cloud ASR (Aliyun NLS) WebSocket client
// ESP32-P4 streams audio to cloud, receives recognized text
// Implements token-based auth: HMAC-SHA1 signature → HTTPS token fetch → WS
#include "voice/asr_client.h"
#include <Arduino.h>
#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <mbedtls/md.h>

static String s_provider;
static String s_appKey, s_apiKey, s_secretKey;
static AsrCallback s_onResult = nullptr;
static AsrCallback s_onError = nullptr;
static WiFiClientSecure s_wsClient;
static WiFiClientSecure s_httpClient;
static bool s_connected = false;
static String s_lastError;
static String s_sessionId;
static String s_token;
static unsigned long s_tokenExpiry = 0;  // millis() when token expires

// ── URL Encode (RFC 3986) ──────────────────────────────────────────────
static String urlEncode(const String& src) {
    String out;
    out.reserve(src.length() * 3);
    for (size_t i = 0; i < src.length(); i++) {
        char c = src[i];
        if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
            (c >= '0' && c <= '9') || c == '-' || c == '_' ||
            c == '.' || c == '~') {
            out += c;
        } else {
            char hex[4];
            snprintf(hex, sizeof(hex), "%%%02X", (uint8_t)c);
            out += hex;
        }
    }
    return out;
}

// ── Base64 Encode ──────────────────────────────────────────────────────
static String base64Encode(const uint8_t* data, size_t len) {
    static const char* tbl = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    String out;
    out.reserve(((len + 2) / 3) * 4);
    for (size_t i = 0; i < len; i += 3) {
        uint32_t n = (uint32_t)data[i] << 16;
        if (i + 1 < len) n |= (uint32_t)data[i + 1] << 8;
        if (i + 2 < len) n |= (uint32_t)data[i + 2];
        out += tbl[(n >> 18) & 0x3F];
        out += tbl[(n >> 12) & 0x3F];
        out += (i + 1 < len) ? tbl[(n >> 6) & 0x3F] : '=';
        out += (i + 2 < len) ? tbl[n & 0x3F] : '=';
    }
    return out;
}

// ── HMAC-SHA1 ──────────────────────────────────────────────────────────
static String hmacSha1(const String& key, const String& msg) {
    uint8_t digest[20];
    mbedtls_md_context_t ctx;
    mbedtls_md_init(&ctx);
    mbedtls_md_setup(&ctx, mbedtls_md_info_from_type(MBEDTLS_MD_SHA1), 1);
    mbedtls_md_hmac_starts(&ctx, (const uint8_t*)key.c_str(), key.length());
    mbedtls_md_hmac_update(&ctx, (const uint8_t*)msg.c_str(), msg.length());
    mbedtls_md_hmac_finish(&ctx, digest);
    mbedtls_md_free(&ctx);
    return base64Encode(digest, 20);
}

// ── ISO 8601 UTC timestamp ─────────────────────────────────────────────
static String iso8601UTC() {
    time_t now;
    time(&now);
    struct tm* utc = gmtime(&now);
    char buf[32];
    strftime(buf, sizeof(buf), "%Y-%m-%dT%H:%M:%SZ", utc);
    return String(buf);
}

// ── UUID v4 (nonce) ────────────────────────────────────────────────────
static String uuidV4() {
    char buf[37];
    uint32_t r[4];
    for (int i = 0; i < 4; i++)
        r[i] = esp_random();
    snprintf(buf, sizeof(buf),
             "%08x-%04x-4%03x-%04x-%04x%08x",
             r[0], (r[1] >> 16) & 0xFFFF, r[1] & 0xFFF,
             ((r[2] >> 16) & 0x3FFF) | 0x8000, r[2] & 0xFFFF, r[3]);
    return String(buf);
}

// ── Generate Aliyun API Signature ──────────────────────────────────────
static String nlsGenerateSignature(const String& httpMethod,
                                    const String& canonicalQuery) {
    String strToSign = httpMethod + "&" + urlEncode("/") + "&" +
                       urlEncode(canonicalQuery);
    String key = s_secretKey + "&";
    return hmacSha1(key, strToSign);
}

// ── Fetch Token from Aliyun NLS meta server ────────────────────────────
bool asrGetToken() {
    // Return cached token if still valid (> 5 min remaining)
    if (s_token.length() > 0) {
        unsigned long remainingMs = s_tokenExpiry - millis();
        if (remainingMs > 5 * 60 * 1000UL) {
            Serial.printf("[ASR] Token cached, %lu s remaining\n",
                          remainingMs / 1000);
            return true;
        }
        Serial.println("[ASR] Token near expiry, refreshing...");
    }

    // Check NTP time is synced
    time_t now;
    time(&now);
    if (now < 1700000000) {  // Before 2023-11-15 — NTP likely not synced
        s_lastError = "NTP time not synced — call configTime() first";
        Serial.println("[ASR] ERROR: NTP time required for token auth");
        return false;
    }

    String timestamp = iso8601UTC();
    String nonce = uuidV4();

    // Build sorted, URL-encoded query params
    String params[9][2] = {
        {"AccessKeyId", s_apiKey},
        {"Action", "CreateToken"},
        {"Format", "JSON"},
        {"SignatureMethod", "HMAC-SHA1"},
        {"SignatureNonce", nonce},
        {"SignatureVersion", "1.0"},
        {"Timestamp", timestamp},
        {"Version", "2018-05-18"},
    };

    // Sort by encoded key
    for (int i = 0; i < 7; i++) {
        for (int j = i + 1; j < 8; j++) {
            if (urlEncode(params[i][0]) > urlEncode(params[j][0])) {
                String tmp0 = params[i][0], tmp1 = params[i][1];
                params[i][0] = params[j][0]; params[i][1] = params[j][1];
                params[j][0] = tmp0; params[j][1] = tmp1;
            }
        }
    }

    String canonicalQuery;
    for (int i = 0; i < 8; i++) {
        if (i > 0) canonicalQuery += "&";
        canonicalQuery += urlEncode(params[i][0]) + "=" +
                          urlEncode(params[i][1]);
    }

    String signature = nlsGenerateSignature("GET", canonicalQuery);

    // Build final query string (unencoded keys/values + encoded signature)
    String query;
    for (int i = 0; i < 8; i++) {
        if (i > 0) query += "&";
        query += params[i][0] + "=" + params[i][1];
    }
    query += "&Signature=" + urlEncode(signature);

    // Make HTTPS GET to token endpoint
    Serial.println("[ASR] Fetching token from nls-meta...");
    s_httpClient.setInsecure();
    const char* metaHost = "nls-meta.cn-shanghai.aliyuncs.com";

    if (!s_httpClient.connect(metaHost, 443)) {
        s_lastError = "Token server connect failed";
        Serial.println("[ASR] Token HTTPS connect FAILED");
        return false;
    }

    String req = "GET /pop/2018-05-18/tokens?" + query + " HTTP/1.1\r\n";
    req += "Host: " + String(metaHost) + "\r\n";
    req += "Accept: application/json\r\n";
    req += "Connection: close\r\n\r\n";
    s_httpClient.print(req);
    s_httpClient.flush();

    // Read response
    String body;
    bool headersDone = false;
    unsigned long t = millis();
    while (millis() - t < 10000) {
        if (s_httpClient.available()) {
            String line = s_httpClient.readStringUntil('\n');
            if (!headersDone) {
                if (line.length() <= 1) { headersDone = true; }
            } else {
                body += line;
            }
        }
        if (!s_httpClient.connected() && !s_httpClient.available()) break;
        delay(1);
    }
    s_httpClient.stop();

    // Parse JSON response for Token.Id
    const char* tokField = strstr(body.c_str(), "\"Id\"");
    if (!tokField) {
        tokField = strstr(body.c_str(), "\"Token\"");
        s_lastError = "Token not found in response";
        Serial.printf("[ASR] Token response: %s\n", body.c_str());
        return false;
    }
    const char* val = strchr(tokField, ':');
    if (!val) { s_lastError = "Invalid token JSON"; return false; }
    val++;
    while (*val == ' ' || *val == '"') val++;
    s_token = "";
    while (*val && *val != '"') { s_token += *val; val++; }

    // Parse ExpireTime
    const char* expField = strstr(body.c_str(), "\"ExpireTime\"");
    unsigned long expireSec = 3600;  // default 1h
    if (expField) {
        const char* ev = strchr(expField, ':');
        if (ev) {
            ev++;
            while (*ev == ' ' || *ev == '"') ev++;
            expireSec = strtoul(ev, nullptr, 10);
        }
    }
    s_tokenExpiry = millis() + (expireSec - 60) * 1000UL;

    Serial.printf("[ASR] Token obtained, expires in %lu s (token: %s...)\n",
                  expireSec, s_token.substring(0, 16).c_str());
    return true;
}

// ── WebSocket text frame ──────────────────────────────────────────────
static bool wsSendText(const char* text) {
    if (!s_wsClient.connected()) return false;
    size_t len = strlen(text);
    uint8_t hdr[10];
    size_t hdrLen = 0;
    hdr[hdrLen++] = 0x81;  // FIN + text
    if (len <= 125) {
        hdr[hdrLen++] = (uint8_t)len;
    } else if (len <= 65535) {
        hdr[hdrLen++] = 126;
        hdr[hdrLen++] = (len >> 8) & 0xFF;
        hdr[hdrLen++] = len & 0xFF;
    }
    s_wsClient.write(hdr, hdrLen);
    s_wsClient.write((const uint8_t*)text, len);
    s_wsClient.flush();
    return true;
}

// ── WebSocket frame reader ────────────────────────────────────────────
struct WsFrame { bool fin; uint8_t opcode; uint8_t* data; size_t len; };

static bool wsRecvFrame(WsFrame& frame) {
    if (!s_wsClient.connected() || s_wsClient.available() < 2) return false;
    uint8_t b0 = s_wsClient.read(), b1 = s_wsClient.read();
    frame.fin = (b0 & 0x80) != 0;
    frame.opcode = b0 & 0x0F;
    bool masked = (b1 & 0x80) != 0;
    uint64_t len = b1 & 0x7F;
    if (len == 126) {
        if (s_wsClient.available() < 2) return false;
        len = (s_wsClient.read() << 8) | s_wsClient.read();
    } else if (len == 127) {
        if (s_wsClient.available() < 8) return false;
        len = 0;
        for (int i = 0; i < 8; i++) len = (len << 8) | s_wsClient.read();
    }
    if (len > 65536) return false;
    uint8_t mask[4] = {0};
    if (masked) {
        if (s_wsClient.available() < 4) return false;
        for (int i = 0; i < 4; i++) mask[i] = s_wsClient.read();
    }
    frame.data = (uint8_t*)malloc(len + 1);
    if (!frame.data) return false;
    size_t total = 0;
    unsigned long t = millis() + 5000;
    while (total < len && millis() < t) {
        int avail = s_wsClient.available();
        if (avail > 0) {
            size_t chunk = (size_t)avail < (len - total) ? avail : (len - total);
            s_wsClient.read(frame.data + total, chunk);
            total += chunk;
        }
        delay(1);
    }
    if (total < len) { free(frame.data); return false; }
    if (masked)
        for (size_t i = 0; i < len; i++) frame.data[i] ^= mask[i % 4];
    frame.data[len] = 0;
    frame.len = len;
    return true;
}

// ── Parse Aliyun NLS JSON result ─────────────────────────────────────
static void parseNlsResult(const char* json) {
    const char* rp = strstr(json, "\"result\"");
    if (!rp) return;
    rp = strchr(rp, ':');
    if (!rp) return;
    rp++;
    while (*rp == ' ' || *rp == '"') rp++;
    char text[256] = {0};
    int i = 0;
    while (*rp && *rp != '"' && i < 255) {
        if (*rp == '\\' && *(rp + 1)) {
            rp++;
            switch (*rp) {
                case 'n': text[i++] = '\n'; break;
                case 't': text[i++] = '\t'; break;
                case 'u': rp += 4; continue;
                default:  text[i++] = *rp; break;
            }
        } else { text[i++] = *rp; }
        rp++;
    }
    text[i] = 0;
    bool isFinal = (strstr(json, "\"SentenceEnd\"") != nullptr);
    if (s_onResult && strlen(text) > 0)
        s_onResult(text, isFinal);
}

// ── Public API ────────────────────────────────────────────────────────
bool asrInit(const char* provider, const char* appKey,
             const char* apiKey, const char* secretKey) {
    s_provider = provider;
    s_appKey = appKey;
    s_apiKey = apiKey;
    s_secretKey = secretKey;
    Serial.printf("[ASR] Init: %s, appKey=%s, akId=%s...\n",
                  provider, appKey, String(apiKey).substring(0, 8).c_str());
    return true;
}

void asrSetCallback(AsrCallback onResult, AsrCallback onError) {
    s_onResult = onResult;
    s_onError = onError;
}

bool asrStartSession() {
    if (s_connected) return true;

    // Require valid token
    if (s_token.length() == 0) {
        s_lastError = "No token — call asrGetToken() first";
        return false;
    }

    s_wsClient.setInsecure();
    const char* host = "nls-gateway.cn-shanghai.aliyuncs.com";

    if (!s_wsClient.connect(host, 443)) {
        s_lastError = "WebSocket connect failed";
        Serial.printf("[ASR] Connect FAILED: %s:443\n", host);
        return false;
    }

    s_sessionId = String(millis(), HEX);

    // Build upgrade URL with token authentication
    String path = "/ws/v1?appkey=" + s_appKey +
                  "&token=" + s_token +
                  "&format=pcm&sample_rate=16000";
    String upgrade = "GET " + path + " HTTP/1.1\r\n";
    upgrade += "Host: " + String(host) + "\r\n";
    upgrade += "Upgrade: websocket\r\n";
    upgrade += "Connection: Upgrade\r\n";
    upgrade += "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n";
    upgrade += "Sec-WebSocket-Version: 13\r\n\r\n";
    s_wsClient.print(upgrade);
    s_wsClient.flush();

    unsigned long t = millis();
    while (millis() - t < 5000) {
        if (s_wsClient.available()) {
            String line = s_wsClient.readStringUntil('\n');
            if (line.startsWith("HTTP/1.1 101")) {
                while (s_wsClient.available() &&
                       s_wsClient.readStringUntil('\n').length() > 2) {}
                s_connected = true;
                Serial.println("[ASR] WebSocket connected (token auth)");
                return true;
            }
        }
        delay(10);
    }
    s_lastError = "WebSocket upgrade timeout";
    s_wsClient.stop();
    return false;
}

bool asrSendAudio(const int16_t* pcm, size_t samples) {
    if (!s_connected) return false;
    size_t byteLen = samples * sizeof(int16_t);
    uint8_t hdr[10];
    size_t hdrLen = 0;
    hdr[hdrLen++] = 0x82;  // FIN + binary
    if (byteLen <= 125) {
        hdr[hdrLen++] = (uint8_t)byteLen;
    } else if (byteLen <= 65535) {
        hdr[hdrLen++] = 126;
        hdr[hdrLen++] = (byteLen >> 8) & 0xFF;
        hdr[hdrLen++] = byteLen & 0xFF;
    }
    s_wsClient.write(hdr, hdrLen);
    s_wsClient.write((const uint8_t*)pcm, byteLen);
    s_wsClient.flush();
    return true;
}

void asrEndSession() {
    if (!s_connected) return;
    wsSendText("{\"header\":{\"name\":\"StopRecognition\"},\"payload\":{}}");
    delay(100);
    s_wsClient.stop();
    s_connected = false;
}

bool asrIsConnected() { return s_connected; }

void asrTick() {
    if (!s_connected) return;
    WsFrame frame;
    if (wsRecvFrame(frame)) {
        if (frame.opcode == 0x01 || frame.opcode == 0x00)
            parseNlsResult((const char*)frame.data);
        else if (frame.opcode == 0x08) {
            s_connected = false; s_wsClient.stop();
        }
        free(frame.data);
    }
}

const char* asrLastError() { return s_lastError.c_str(); }
